{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-sensitive-file-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-readme-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-bash-dangerous-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-go-lint.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-yaml-format.sh"
          }
        ]
      }
    ]
  }
}
